{
    "train_batch_size": 16,
    "gradient_accumulation_steps": 1,
    "gradient_clipping": 1.0,
    "steps_per_print": 10,
    "wall_clock_breakdown": false,
    
    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": 1e-4,
            "betas": [0.9, 0.999],
            "eps": 1e-8,
            "weight_decay": 0.01
        }
    },
    
    "scheduler": {
        "type": "WarmupLR",
        "params": {
            "warmup_min_lr": 0,
            "warmup_max_lr": 1e-4,
            "warmup_num_steps": 100
        }
    },
    
    "zero_optimization": {
        "stage": 2,
        "allgather_partitions": true,
        "allgather_bucket_size": 500000000,
        "overlap_comm": true,
        "reduce_scatter": true,
        "reduce_bucket_size": 500000000,
        "contiguous_gradients": true,
        "cpu_offload": false
    },
    
    "fp16": {
        "enabled": false
    },
    
    "bf16": {
        "enabled": true
    },
    
    "zero_allow_untested_optimizer": true,
    "logging": {
        "enabled": true,
        "steps_per_print": 10
    },
    
    "comms_logger": {
        "enabled": false
    },
    
    "tensorboard": {
        "enabled": false
    },
    
    "wandb": {
        "enabled": true,
        "project": "lisa-gemma-deepspeed"
    }
} 