{
  "train_batch_size": 8,
  "train_micro_batch_size_per_gpu": 2,
  "gradient_accumulation_steps": 2,
  "steps_per_print": 5,

  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 2e-4,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "weight_decay": 1e-2
    }
  },

  "scheduler": {
    "type": "WarmupLR",
    "params": {
      "warmup_min_lr": 1e-5,
      "warmup_max_lr": 2e-4,
      "warmup_num_steps": 5
    }
  },

  "fp16": {
    "enabled": false
  },
  "bf16": {
    "enabled": true
  },

  "zero_optimization": {
    "stage": 2,
    "offload_optimizer": {
      "device": "cpu",
      "pin_memory": true
    },
    "contiguous_gradients": true,
    "overlap_comm": true,
    "reduce_bucket_size": 5e8
  },

  "gradient_clipping": 1.0,
  "wall_clock_breakdown": false,
  "tensorboard": {
    "enabled": true,
    "output_path": "./runs/small_test_logs/",
    "job_name": "lisa_gemma3_small_test"
  }
} 